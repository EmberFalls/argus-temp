{
  "$defs": {
    "SpecClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "critical",
            "high",
            "normal",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "journey_ids": {
          "items": {
            "type": "string"
          },
          "title": "Journey Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement"
      ],
      "title": "SpecClaim",
      "type": "object"
    },
    "SpecEntity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SpecEntity",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "goto",
            "click",
            "fill",
            "hover",
            "wait",
            "assert"
          ],
          "title": "Action",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "timeout_ms": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "TestCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "journey": {
          "minLength": 1,
          "title": "Journey",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Steps",
          "type": "array"
        },
        "expected": {
          "default": "",
          "title": "Expected",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "category": {
          "default": "journey",
          "enum": [
            "journey",
            "edge_case"
          ],
          "title": "Category",
          "type": "string"
        },
        "source": {
          "default": "spec",
          "enum": [
            "spec",
            "playbook"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "journey",
        "description"
      ],
      "title": "TestCase",
      "type": "object"
    },
    "ValidationRule": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "field",
        "rule"
      ],
      "title": "ValidationRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "journeys": {
      "items": {
        "$ref": "#/$defs/TestCase"
      },
      "title": "Journeys",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/SpecClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/SpecEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "validation_rules": {
      "items": {
        "$ref": "#/$defs/ValidationRule"
      },
      "title": "Validation Rules",
      "type": "array"
    },
    "auth_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Auth Requirements",
      "type": "array"
    }
  },
  "required": [
    "description"
  ],
  "title": "Spec",
  "type": "object"
}
