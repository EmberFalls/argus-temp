{
  "$defs": {
    "Step": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "goto",
            "click",
            "fill",
            "hover",
            "wait",
            "assert"
          ],
          "title": "Action",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "timeout_ms": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "action"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "journey": {
      "minLength": 1,
      "title": "Journey",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "title": "Steps",
      "type": "array"
    },
    "expected": {
      "default": "",
      "title": "Expected",
      "type": "string"
    },
    "claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Claim Ids",
      "type": "array"
    },
    "category": {
      "default": "journey",
      "enum": [
        "journey",
        "edge_case"
      ],
      "title": "Category",
      "type": "string"
    },
    "source": {
      "default": "spec",
      "enum": [
        "spec",
        "playbook"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "journey",
    "description"
  ],
  "title": "TestCase",
  "type": "object"
}
