# OpenAI-compatible gateway endpoint. Model/provider swaps are configuration-only.
ARGUS_MODEL_BASE_URL=
ARGUS_MODEL_API_KEY=
ARGUS_MODEL_MODE=live
ARGUS_MODEL_CASSETTE_DIR=fixtures/model_cassettes

# One model name per tier. Explorer defaults to cheap; Red Team uses strong_alt.
ARGUS_MODEL_CHEAP_PROVIDER=openai_compatible
ARGUS_MODEL_CHEAP_NAME=
ARGUS_MODEL_STRONG_PROVIDER=openai_compatible
ARGUS_MODEL_STRONG_NAME=
ARGUS_MODEL_STRONG_ALT_PROVIDER=openai_compatible
ARGUS_MODEL_STRONG_ALT_NAME=
ARGUS_MODEL_VLM_PROVIDER=openai_compatible
ARGUS_MODEL_VLM_NAME=
ARGUS_EXPLORER_MODEL_TIER=cheap

# Shared rate limit and per-run budgets.
ARGUS_MODEL_RPM=60
ARGUS_MODEL_MAX_CALLS=100
ARGUS_MODEL_MAX_TOKENS=100000
ARGUS_MODEL_MAX_TOKENS_PER_CALL=8192

ARGUS_ARTIFACT_DIR=artifacts
ARGUS_ALLOWED_DOMAINS=localhost,127.0.0.1
# Optional single-tenant API bearer token. When set, send Authorization: Bearer <token>.
ARGUS_API_TOKEN=

# Browser-visible URL for the Python API used by the Vite frontend.
VITE_ARGUS_API_URL=http://localhost:8000
# Local development only: Vite embeds this value in the browser bundle.
VITE_ARGUS_API_TOKEN=
